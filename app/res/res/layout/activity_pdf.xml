<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/part_topbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="① 选择转换方向"
                    style="@style/CardText" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/modeChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- PDF → 图片 -->
            <LinearLayout
                android:id="@+id/cardPdfToImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② PDF 文件"
                    style="@style/CardText" />

                <Button
                    android:id="@+id/btnPickPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="选择 PDF 文件"
                    style="@style/GhostButton" />

                <TextView
                    android:id="@+id/tvPdfInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="还没有选择 PDF"
                    style="@style/CaptionText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="页码范围（留空 = 全部）"
                    style="@style/CaptionText" />

                <EditText
                    android:id="@+id/etPageRange"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:hint="例如 1-3,5"
                    android:inputType="text"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/pdfImgOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="输出格式"
                        style="@style/CaptionText" />

                    <LinearLayout
                        android:id="@+id/pdfFmtChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="清晰度"
                        style="@style/CaptionText" />

                    <LinearLayout
                        android:id="@+id/dpiChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pdfTextOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="文本输出格式"
                        style="@style/CaptionText" />

                    <LinearLayout
                        android:id="@+id/pdfTextOutChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="只抽取文字层，不还原版式；扫描件、图片型 PDF 里没有文字层，抽取会失败，请改用「PDF 转图片」。"
                        style="@style/CaptionText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPptxNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="PDF 转 PPTX 是图片版：每页 PDF 渲染成一张高清图，放进一张满版幻灯片，排版、字号、图表都保持原样，但不可再编辑文字。清晰度选项同样生效。"
                    android:visibility="gone"
                    style="@style/CaptionText" />
            </LinearLayout>

            <!-- PPTX → PDF -->
            <LinearLayout
                android:id="@+id/cardPptxToPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② PPTX 文件"
                    style="@style/CardText" />

                <Button
                    android:id="@+id/btnPickPptx"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="选择 PPTX 文件"
                    style="@style/GhostButton" />

                <TextView
                    android:id="@+id/tvPptxInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="还没有选择 PPTX"
                    style="@style/CaptionText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="幻灯片里如果嵌了整页图片（比如本工具生成的图片版 PPTX），会按原图铺满整页还原；纯文字幻灯片按文字重新排版成 PDF。"
                    style="@style/CaptionText" />
            </LinearLayout>

            <!-- 图片 → PDF -->
            <LinearLayout
                android:id="@+id/cardImgToPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② 图片"
                    style="@style/CardText" />

                <Button
                    android:id="@+id/btnPickImagesPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="选择图片（可多选，按名字排序）"
                    style="@style/GhostButton" />

                <TextView
                    android:id="@+id/tvImgInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="还没有选择图片"
                    style="@style/CaptionText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="页面尺寸"
                    style="@style/CaptionText" />

                <LinearLayout
                    android:id="@+id/paperChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnPdfConvert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开始转换"
                    style="@style/PrimaryButton" />

                <ProgressBar
                    android:id="@+id/pbPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPdfStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="转换结果会显示在这里"
                    style="@style/CaptionText" />

                <LinearLayout
                    android:id="@+id/pdfResultHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnPdfSaveAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="保存全部到文件夹"
                    android:visibility="gone"
                    style="@style/SoftButton" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
