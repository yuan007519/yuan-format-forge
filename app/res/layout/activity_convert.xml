<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/part_topbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="① 选择任意音视频文件"
                    style="@style/CardText" />

                <Button
                    android:id="@+id/btnPickAny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="选择文件"
                    style="@style/GhostButton" />

                <TextView
                    android:id="@+id/tvAnyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="内置 FFmpeg 内核，正在初始化…"
                    style="@style/CaptionText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② 输出格式"
                    style="@style/CardText" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/anyOutChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="画质档位"
                    style="@style/CaptionText" />

                <LinearLayout
                    android:id="@+id/anyQualityChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="高清＝保留原分辨率；标准＝最长边不超过 1080；小体积＝最长边不超过 720。纯音频输出时画质档位不生效。"
                    style="@style/CaptionText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="同名文件"
                    style="@style/CaptionText" />

                <LinearLayout
                    android:id="@+id/anyDupChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="另存＝输出目录里重名时自动加 (2)；覆盖＝直接替换同名文件，适合反复测试同一段素材。"
                    style="@style/CaptionText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardRestore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CardText"
                    android:text="上次没转完的队列" />

                <TextView
                    android:id="@+id/tvRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    style="@style/CaptionText"
                    android:text="—" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRestoreQueue"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.2"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        style="@style/SoftButton"
                        android:text="恢复队列" />

                    <Button
                        android:id="@+id/btnDropQueue"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        style="@style/SoftButton"
                        android:text="不用了" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAnyAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnAnyConvert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开始转码"
                    style="@style/PrimaryButton" />

                <Button
                    android:id="@+id/btnAnyCancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="取消"
                    style="@style/SoftButton" />

                <ProgressBar
                    android:id="@+id/pbAny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAnyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="转换进度会显示在这里"
                    style="@style/CaptionText" />

                <TextView
                    android:id="@+id/tvAnyLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:ellipsize="start"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:id="@+id/anyResultHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="6dp"
                android:lineSpacingExtra="3dp"
                android:text="转码会重新编码，耗时与视频长度、机型性能有关：10 分钟 1080p 视频大约 1–4 分钟。大文件请留出足够空间。"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
